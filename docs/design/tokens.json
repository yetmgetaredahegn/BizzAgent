  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Familjen Grotesk",
          "Noto Serif Ethiopic",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Atkinson Hyperlegible Next",
          "Noto Sans Ethiopic",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Atkinson Hyperlegible Mono",
          "ui-monospace",
          "monospace"
        ]
      },
      "ethiopic": {
        "$type": "fontFamily",
        "$value": [
          "Noto Sans Ethiopic",
          "sans-serif"
        ]
      },
      "ethiopic-display": {
        "$type": "fontFamily",
        "$value": [
          "Noto Serif Ethiopic",
          "serif"
        ]
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "14px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "22px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "28px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "36px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "48px"
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.5
      },
      "ethiopic": {
        "$type": "number",
        "$value": 1.7
      },
      "tight": {
        "$type": "number",
        "$value": 1.15
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "stamp": {
      "$type": "dimension",
      "$value": "2px"
    },
    "sheet": {
      "$type": "dimension",
      "$value": "8px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "active-sheet": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-12px",
        "color": "#16172240"
      }
    }
  },
  "motion": {
    "stamp-press": {
      "$type": "duration",
      "$value": "140ms"
    },
    "standard": {
      "$type": "duration",
      "$value": "180ms"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.7,
        0.2,
        1
      ]
    },
    "landing-print": {
      "$type": "duration",
      "$value": "2400ms",
      "$description": "landing hero receipt prints once"
    }
  },
  "size": {
    "touch-target": {
      "$type": "dimension",
      "$value": "44px"
    },
    "logo-min": {
      "$type": "dimension",
      "$value": "20px"
    }
  },
  "breakpoint": {
    "$description": "Container/viewport width at which a size class begins (px). Use min-width queries.",
    "phone": {
      "$type": "dimension",
      "$value": "360px"
    },
    "tablet": {
      "$type": "dimension",
      "$value": "600px"
    },
    "laptop": {
      "$type": "dimension",
      "$value": "1024px"
    },
    "desktop": {
