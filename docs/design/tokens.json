{
  "$description": "BizzAgent design tokens (W3C Design Tokens format). Source of truth for web/src/styles/tokens.css, generated by `npm run tokens` in PR F. Contrast is documented in BRAND.md.",
  "color": {
    "light": {
      "paper": {
        "$type": "color",
        "$value": "#F3F4F8"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "ink": {
        "$type": "color",
        "$value": "#161722"
      },
      "muted": {
        "$type": "color",
        "$value": "#555A6E"
      },
      "line": {
        "$type": "color",
        "$value": "#D9DBE6",
        "$description": "decorative dividers only"
      },
      "line-strong": {
        "$type": "color",
        "$value": "#82879B",
        "$description": "control borders, >= 3:1"
      },
      "stamp": {
        "$type": "color",
        "$value": "#4A2FBF"
      },
      "stamp-strong": {
        "$type": "color",
        "$value": "#36209A"
      },
      "on-stamp": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "meskel": {
        "$type": "color",
        "$value": "#F2C230",
        "$description": "highlight fill only, never text"
      },
      "copy-pink": {
        "$type": "color",
        "$value": "#FBE9EE"
      },
      "copy-yellow": {
        "$type": "color",
        "$value": "#FFF6D6"
      },
      "established": {
        "$type": "color",
        "$value": "#1C6E47"
      },
      "unverified": {
        "$type": "color",
        "$value": "#8A5300"
      },
      "missing": {
        "$type": "color",
        "$value": "#5B6274"
      },
      "contradictory": {
        "$type": "color",
        "$value": "#B42A22"
      }
    },
    "dark": {
      "paper": {
        "$type": "color",
        "$value": "#111219"
