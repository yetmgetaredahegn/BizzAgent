      "$type": "dimension",
      "$value": "216px"
    },
    "rail-collapsed": {
      "$type": "dimension",
      "$value": "64px"
    },
    "side-column": {
      "$type": "dimension",
      "$value": "320px"
    },
    "gutter-phone": {
      "$type": "dimension",
      "$value": "16px"
    },
    "gutter-tablet": {
      "$type": "dimension",
      "$value": "24px"
    },
    "gutter-desktop": {
      "$type": "dimension",
      "$value": "36px"
    }
  }
