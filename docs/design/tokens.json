      "line": {
        "$type": "color",
        "$value": "#2E3040"
      },
      "line-strong": {
        "$type": "color",
        "$value": "#6C7088"
      },
      "stamp": {
        "$type": "color",
        "$value": "#A99BFF"
      },
      "stamp-strong": {
        "$type": "color",
        "$value": "#C4BAFF"
      },
      "on-stamp": {
        "$type": "color",
        "$value": "#111219"
      },
      "meskel": {
        "$type": "color",
        "$value": "#F2C230"
      },
      "copy-pink": {
        "$type": "color",
        "$value": "#2A1F27"
      },
      "copy-yellow": {
        "$type": "color",
        "$value": "#29261A"
      },
      "established": {
        "$type": "color",
        "$value": "#5CC98F"
      },
      "unverified": {
        "$type": "color",
        "$value": "#F0B44C"
      },
      "missing": {
        "$type": "color",
        "$value": "#9AA1B5"
      },
      "contradictory": {
        "$type": "color",
        "$value": "#FF7A6E"
      }
    }
