# Copy to backend/.env and adjust. Every setting is optional.

# dev | test | prod
BIZZAGENT_ENV=dev

# Comma-separated browser origins allowed to call the API.
BIZZAGENT_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where uploaded and generated media is written (gitignored by default).
# BIZZAGENT_MEDIA_DIR=./var/media
